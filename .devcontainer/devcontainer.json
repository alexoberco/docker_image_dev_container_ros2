{
    "name": "ROS 2 Humble + Gazebo Fortress",
    "build": {
        "context": "..",
        "dockerfile": "../Dockerfile"
    },
    "remoteUser": "ros",
    // Forzar el espacio de trabajo en la ruta limpia de ROS 2
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ros/ros2_ws,type=bind",
    "workspaceFolder": "/home/ros/ros2_ws",
    "runArgs": [
        "--network=host",
        "--ipc=host",
        "--privileged",
        "-e",
        "DISPLAY=${env:DISPLAY}",
        "-v",
        "/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "--gpus",
        "all"
    ],
    "features": {
        "ghcr.io/devcontainers/features/python:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python",
                "ms-vscode.cpptools",
                "redhat.vscode-xml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.exclude": {
                    "**/.devcontainer": true,
                    "**/Dockerfile": true,
                    "**/devcontainer.json": true,
                    "**/README.md": true
                }
            }
        }
    }
}